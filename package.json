{
  "name": "atlas-markets",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web \"node --watch server/index.js\" \"vite --host 0.0.0.0\"",
    "build": "vite build",
    "start": "node server/index.js",
    "test": "node --test tests/*.test.js",
    "test:e2e": "playwright test",
    "format": "prettier --write src shared server tests *.js *.json *.html *.md",
    "build:firebase": "vite build --mode firebase",
    "deploy:firebase": "npx --yes firebase-tools@15.34.2 deploy --only hosting --project sharp-nex",
    "test:firebase": "npm run build:firebase && playwright test --config playwright.firebase.config.js",
    "build:pages": "vite build --mode firebase --base=/stock-screener/"
  },
  "dependencies": {
    "d3-hierarchy": "^3.1.2",
    "express": "^5.1.0",
    "lightweight-charts": "^5.0.8",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "undici": "^7.16.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^9.1.2",
    "prettier": "^3.9.10",
    "vite": "^6.3.5"
  },
  "engines": {
    "node": ">=22"
  }
}
